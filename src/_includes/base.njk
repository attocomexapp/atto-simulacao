<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seo_titulo or title }} | Atto Comex</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ seo_titulo or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ capa or '/assets/img/hero.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#070F1A">
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="alternate" type="application/rss+xml" title="Blog Atto Comex" href="/blog/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/blog.css">
{% block head %}{% endblock %}
</head>
<body>
<header class="top">
  <div class="wrap nav">
    <a href="/"><img src="/assets/img/logo-atto.png" alt="Atto Comex" class="logo"></a>
    <div class="nav-r">
      <a class="pill" href="/blog/">Blog</a>
      <a class="pill pill-fa" href="/#simulacao">Simular importação</a>
    </div>
  </div>
</header>
<main>
{{ content | safe }}
</main>
<section class="cta-end">
  <div class="wrap">
    <p class="lbl">Simulação gratuita</p>
    <h2>Quanto custa trazer o seu produto <b>da China?</b></h2>
    <p>Responda em 2 minutos. A Atto devolve a estimativa de custo e o orçamento no seu WhatsApp.</p>
    <a class="btn" href="/#simulacao">Fazer minha simulação →</a>
  </div>
</section>
<footer><div class="wrap"><span>Atto Comex LTDA · CNPJ 59.815.528/0001-61 · Maringá, PR</span><span><a href="/blog/">Blog</a> · @attocomex · www.attocomex.com</span></div></footer>
<a class="wa" href="https://wa.me/{{ site.whatsapp }}?text=Ol%C3%A1%2C%20Atto!%20Vim%20pelo%20blog." target="_blank" rel="noopener" aria-label="Falar com a Atto no WhatsApp">
  <svg width="30" height="30" viewBox="0 0 32 32" fill="#fff" aria-hidden="true"><path d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.53 1.74 6.5L3 29l6.68-1.75A12.95 12.95 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3zm0 23.66c-1.98 0-3.92-.53-5.6-1.54l-.4-.24-3.960 1.04 1.06-3.86-.26-.4A10.6 10.6 0 0 1 5.38 16c0-5.88 4.78-10.66 10.66-10.66 5.87 0 10.62 4.78 10.62 10.66 0 5.870-4.75 10.66-10.62 10.66zm5.84-7.98c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.15-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.090-1.12 2.66 0 1.57 1.14 3.08 1.3 3.3.16.2 2.25 3.43 5.44 4.81.76.33 1.35.52 1.82.67.76.24 1.46.2 2 .12.61-.09 1.89-.77 2.15-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37z"/></svg>
</a>
</body>
</html>
