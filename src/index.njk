<script>
(function(){
  /* ===== CONFIGURAÇÃO ===== */
  var ENDPOINT = 'https://script.google.com/macros/s/AKfycbxab4vXjE54hkOglsNFJltO62V5yJrUZlNbAACpNXk7_RkcS0owTUqy25DUz2FiiJjUvw/exec';
  var WHATSAPP = '5511994923475';
  var VIDEO_HERO = ''; // opcional: link de um .mp4 curto (10 a 20 s) para o fundo do topo

  if (VIDEO_HERO) document.getElementById('heroMedia').innerHTML = '<video src="' + VIDEO_HERO + '" autoplay muted loop playsinline></video>';
  var waBase = 'https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent('Olá, Atto! Vim pelo site e quero falar sobre importação.');
  document.querySelectorAll('.wa-link').forEach(function(a){ a.href = waBase; });

  var q = new URLSearchParams(location.search);
  var UTM = { utm_source: q.get('utm_source') || (document.referrer ? new URL(document.referrer).hostname : 'direto'), utm_campaign: q.get('utm_campaign') || '' };

  var SEG = ['Peças para carro e moto','Brinquedos','Artigos de bebê','Casa e cozinha','Pet','Eletrônicos e acessórios','Máquinas e equipamentos','Ferramentas'];
  var FLOWS = {
    imp: { label:'Simulação de importação', steps:[
      { type:'text', key:'produto', title:'Qual produto você quer importar?', sub:'Pode ser um produto, uma máquina ou um segmento inteiro.', label:'Produto ou segmento', ph:'Ex.: pastilha de freio para moto, mordedor de silicone', chips:SEG },
      { type:'photos', title:'Fotos e detalhes do produto', sub:'Opcional, mas deixa a estimativa bem mais precisa. Até 4 fotos do produto, catálogo ou embalagem.', fields:[['medidas','Medidas ou volume','Ex.: 30 x 20 x 10 cm'],['quantidade','Quantidade','Ex.: 2.000 unidades'],['acabamento','Cor ou acabamento','Ex.: preto fosco, inox']] },
      { type:'options', key:'fornecedor', title:'Você já tem fornecedor na China?', sub:'Assim a gente sabe se começa pela busca de fábrica ou direto pela logística.', options:[['Sim','Já tenho fornecedor cotado ou em contato'],['Não','Preciso de ajuda para encontrar e validar uma fábrica'],['Estou pesquisando','Ainda comparando catálogos e opções']] },
      { type:'options', key:'experiencia', title:'Sua empresa já importa?', sub:'A orientação muda conforme o Radar e a experiência da empresa.', options:[['Nunca importou','Será a primeira importação da empresa'],['Algumas vezes','Já fez operações pontuais'],['Importa com frequência','Tem Radar ativo e compra com regularidade']] },
      { type:'options', key:'valor', title:'Quanto pretende investir?', sub:'Valor aproximado da compra. Ajuda a indicar container compartilhado ou completo.', options:[['Até R$ 10 mil','Amostras e teste de produto'],['R$ 10 mil a R$ 50 mil','Normalmente container compartilhado'],['R$ 50 mil a R$ 100 mil','Lotes médios de reposição'],['R$ 100 mil a R$ 500 mil','Container compartilhado grande ou completo'],['Acima de R$ 500 mil','Volumes de indústria e atacado']] },
      { type:'options', key:'canal', multi:true, title:'Onde você vai vender?', sub:'O canal muda a conta de margem, embalagem e giro de estoque.', options:[['Mercado Livre','Full ou coleta'],['Amazon','FBA ou FBM'],['Shopee','Loja oficial ou vendedor'],['TikTok Shop','Venda pelas redes'],['Loja física','Ponto de venda ou distribuição'],['E-commerce próprio','Site da sua marca'],['Atacado','Revenda B2B'],['Indústria','Uso na própria produção']] },
      { type:'contact', title:'Para onde enviamos sua simulação?', sub:'A equipe de comércio exterior da Atto responde com a estimativa de custo e o orçamento.' }
    ]},
    cn: { label:'Missão China', steps:[
      { type:'options', key:'visitou', title:'Você já esteve na China?', sub:'Assim a gente dimensiona o apoio desde a chegada.', options:[['Não, seria a primeira vez','Preciso de orientação desde o visto até as visitas'],['Sim, já estive','Quero aproveitar melhor feiras, contatos e visitas']] },
      { type:'options', key:'objetivo', title:'Qual o principal objetivo da viagem?', sub:'Define a agenda e as regiões que entram no roteiro.', options:[['Visitar fábricas','Conhecer a produção e negociar direto com o fabricante'],['Feiras como a Canton Fair','Ver centenas de fornecedores em poucos dias'],['Pesquisar produtos','Encontrar novidades antes de chegarem ao Brasil'],['Marca própria','Desenvolver embalagem e produto exclusivos']] },
      { type:'text', key:'segmento', title:'Quais produtos você procura?', sub:'Conte o segmento para a gente montar o roteiro certo.', label:'Segmento ou produtos', ph:'Ex.: autopeças, utilidades, artigos de bebê', chips:SEG },
      { type:'options', key:'idioma', note:true, title:'Como está seu inglês?', sub:'Só para planejar o apoio com idioma nas reuniões.', options:[['Falo com segurança','Conduzo negociações sozinho'],['Básico ou intermediário','Entendo, mas prefiro apoio nas negociações'],['Não falo','Preciso de tudo em português']] },
      { type:'contact', timing:['Próximos 3 meses','Em até 6 meses','Em até 12 meses','Ainda avaliando'], title:'Quando pretende ir e como falamos com você?', sub:'A Atto responde com as próximas datas e o roteiro sugerido.' }
    ]}
  };
  var LABELS = { produto:'Produto', medidas:'Medidas', quantidade:'Quantidade', acabamento:'Acabamento', fornecedor:'Fornecedor', experiencia:'Experiência', valor:'Investimento', canal:'Canal', visitou:'Já foi à China', objetivo:'Objetivo', segmento:'Segmento', idioma:'Inglês', quando:'Quando', nome:'Nome', whatsapp:'WhatsApp', empresa:'Empresa', email:'E-mail' };

  var S = { flow:'imp', i:0, A:{ imp:{}, cn:{} }, fotos:[] };
  var $ = function(id){ return document.getElementById(id); };
  var esc = function(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
  function track(ev, data){ window.dataLayer = window.dataLayer || []; window.dataLayer.push(Object.assign({ event: ev }, data || {})); if (ev === 'lead_enviado' && typeof fbq === 'function') fbq('track', 'Lead'); }

  function field(key, label, ph, type){
    return '<div class="f"><label for="f-' + key + '">' + label + '</label><input id="f-' + key + '" data-k="' + key + '" type="' + (type || 'text') + '" placeholder="' + esc(ph) + '" value="' + esc(S.A[S.flow][key] || '') + '"' + (type === 'tel' ? ' inputmode="tel" autocomplete="tel"' : '') + '></div>';
  }

  function render(){
    var F = FLOWS[S.flow], d = F.steps[S.i], A = S.A[S.flow], h = '';
    document.querySelectorAll('.tabs button').forEach(function(b){ b.setAttribute('aria-selected', b.dataset.flow === S.flow); });
    $('flowLabel').textContent = F.label;
    $('stepLabel').textContent = 'Etapa ' + (S.i + 1) + ' de ' + F.steps.length;
    $('bars').innerHTML = F.steps.map(function(_, k){ return '<i class="' + (k <= S.i ? 'on' : '') + '"></i>'; }).join('');
    h += '<div class="step"><h3>' + d.title + '</h3><p class="sub">' + d.sub + '</p>';
    if (d.type === 'text'){
      h += field(d.key, d.label, d.ph) + '<p class="q" style="margin:24px 0 12px">Mais procurados</p><div class="chips">' +
        d.chips.map(function(c){ return '<button type="button" class="chip' + (A[d.key] === c ? ' sel' : '') + '" data-chip="' + esc(c) + '">' + c + '</button>'; }).join('') + '</div>';
    }
    if (d.type === 'photos'){
      h += '<div class="meta" style="margin-bottom:12px"><span>Fotos do produto</span><span>' + S.fotos.length + ' de 4</span></div><div class="photos">';
      for (var n = 0; n < 4; n++){
        var f = S.fotos[n];
        h += f ? '<div class="ph"><img src="' + f.base64 + '" alt="Foto ' + (n+1) + '"><button type="button" class="x" data-rm="' + n + '" aria-label="Remover foto">✕</button></div>'
               : '<label class="ph"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg>Adicionar foto<input type="file" accept="image/*" multiple hidden data-file></label>';
      }
      h += '</div><div class="grid3">' + d.fields.map(function(x){ return field(x[0], x[1], x[2]); }).join('') + '</div>';
    }
    if (d.type === 'options'){
      if (d.multi) h += '<p class="multi">Pode marcar mais de um</p>';
      h += '<div class="opts">' + d.options.map(function(o){
        var cur = A[d.key], sel = d.multi ? (cur || []).indexOf(o[0]) > -1 : cur === o[0];
        return '<button type="button" class="opt' + (sel ? ' sel' : '') + '" aria-pressed="' + sel + '" data-opt="' + esc(o[0]) + '"><div><b>' + o[0] + '</b><span>' + o[1] + '</span></div><em></em></button>';
      }).join('') + '</div>';
      if (d.note) h += '<p class="note">Não fala inglês nem mandarim? Sem problema. A equipe da Atto organiza o apoio com idioma nas reuniões e visitas.</p>';
    }
    if (d.type === 'contact'){
      if (d.timing) h += '<p class="q">Quando pretende viajar</p><div class="chips" style="margin-bottom:26px">' + d.timing.map(function(t){ return '<button type="button" class="chip' + (A.quando === t ? ' sel' : '') + '" data-when="' + esc(t) + '">' + t + '</button>'; }).join('') + '</div>';
      h += '<div class="grid3">' + field('nome','Seu nome','Nome e sobrenome') + field('whatsapp','WhatsApp com DDD','(44) 99999-9999','tel') + field('empresa','Empresa','Razão social ou marca') + '</div>';
      h += '<div class="grid3" style="margin-top:16px">' + field('email','E-mail (opcional)','voce@empresa.com.br','email') + '</div>';
      h += '<p class="lgpd">Seus dados são usados só para responder esta simulação, conforme a LGPD.</p>';
    }
    $('stepBox').innerHTML = h + '</div>';
    $('back').style.visibility = S.i ? 'visible' : 'hidden';
    $('next').innerHTML = S.i === F.steps.length - 1 ? (S.flow === 'imp' ? 'Quero receber minha simulação →' : 'Quero receber meu roteiro →') : 'Avançar →';
    $('err').hidden = true;
  }

  function setA(k, v){ S.A[S.flow][k] = v; }

  $('stepBox').addEventListener('input', function(e){
    var k = e.target.dataset.k; if (!k) return;
    if (e.target.type === 'tel'){
      var dg = e.target.value.replace(/\D/g,'').slice(0,11), o = dg;
      if (dg.length > 2) o = '(' + dg.slice(0,2) + ') ' + dg.slice(2);
      if (dg.length > 7) o = '(' + dg.slice(0,2) + ') ' + dg.slice(2, dg.length-4) + '-' + dg.slice(-4);
      e.target.value = o;
    }
    setA(k, e.target.value);
    if (S.i === 0 && !S.started){ S.started = true; track('simulacao_inicio', { fluxo: S.flow }); }
  });

  $('stepBox').addEventListener('click', function(e){
    var t = e.target.closest('button'); if (!t) return;
    var d = FLOWS[S.flow].steps[S.i], A = S.A[S.flow];
    if (t.dataset.chip){ setA(d.key, t.dataset.chip); render(); }
    else if (t.dataset.when){ setA('quando', t.dataset.when); render(); }
    else if (t.dataset.rm){ S.fotos.splice(+t.dataset.rm, 1); render(); }
    else if (t.dataset.opt){
      var v = t.dataset.opt;
      if (d.multi){ var arr = A[d.key] || []; setA(d.key, arr.indexOf(v) > -1 ? arr.filter(function(x){ return x !== v; }) : arr.concat([v])); render(); }
      else { setA(d.key, v); render(); setTimeout(function(){ if (FLOWS[S.flow].steps[S.i] === d) go(1); }, 260); }
    }
  });

  $('stepBox').addEventListener('change', function(e){
    if (!e.target.hasAttribute('data-file')) return;
    var files = Array.prototype.slice.call(e.target.files, 0, 4 - S.fotos.length);
    Promise.all(files.map(shrink)).then(function(list){ S.fotos = S.fotos.concat(list.filter(Boolean)); render(); });
  });

  function shrink(file){
    return new Promise(function(res){
      var r = new FileReader();
      r.onload = function(){
        var img = new Image();
        img.onload = function(){
          var m = 1280, w = img.width, h = img.height, s = Math.min(1, m / Math.max(w, h));
          var c = document.createElement('canvas'); c.width = Math.round(w * s); c.height = Math.round(h * s);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          res({ base64: c.toDataURL('image/jpeg', .78), mime: 'image/jpeg' });
        };
        img.onerror = function(){ res(null); };
        img.src = r.result;
      };
      r.readAsDataURL(file);
    });
  }

  function valid(d, A){
    if (d.type === 'text') return (A[d.key] || '').trim().length > 1 || 'Conte qual é o produto ou segmento.';
    if (d.type === 'options') return (d.multi ? (A[d.key] || []).length > 0 : !!A[d.key]) || 'Escolha uma opção para continuar.';
    if (d.type === 'contact'){
      if (d.timing && !A.quando) return 'Escolha quando pretende viajar.';
      if ((A.nome || '').trim().length < 2) return 'Informe seu nome.';
      if ((A.whatsapp || '').replace(/\D/g,'').length < 10) return 'Informe um WhatsApp válido com DDD.';
      if ((A.empresa || '').trim().length < 2) return 'Informe o nome da empresa.';
    }
    return true;
  }

  function go(dir){
    var F = FLOWS[S.flow], d = F.steps[S.i];
    if (dir > 0){
      var v = valid(d, S.A[S.flow]);
      if (v !== true){ $('err').textContent = v; $('err').hidden = false; return; }
      if (S.i === F.steps.length - 1) return submit();
      track('simulacao_etapa', { fluxo: S.flow, etapa: S.i + 1 });
    }
    S.i = Math.max(0, S.i + dir); render();
    var card = document.querySelector('.card'); if (card.getBoundingClientRect().top < 0) card.scrollIntoView({ behavior:'smooth', block:'start' });
  }
  $('next').addEventListener('click', function(){ go(1); });
  $('back').addEventListener('click', function(){ go(-1); });
  $('stepBox').addEventListener('keydown', function(e){ if (e.key === 'Enter' && e.target.tagName === 'INPUT'){ e.preventDefault(); go(1); } });
  document.querySelectorAll('.tabs button').forEach(function(b){ b.addEventListener('click', function(){ S.flow = b.dataset.flow; S.i = 0; render(); }); });

  function submit(){
    var A = S.A[S.flow], btn = $('next');
    btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Enviando';
    var payload = Object.assign({ tipo: S.flow, pagina: location.href }, UTM, A);
    if (S.flow === 'imp' && S.fotos.length) payload.fotos = S.fotos;
    var msg = 'Olá, Atto! ' + (S.flow === 'imp' ? 'Acabei de fazer a simulação de importação no site.' : 'Quero planejar uma viagem à China com a Atto.') + '\n\n' +
      Object.keys(A).filter(function(k){ return A[k] && (A[k].length || A[k] === true); }).map(function(k){ return '*' + (LABELS[k] || k) + ':* ' + (Array.isArray(A[k]) ? A[k].join(', ') : A[k]); }).join('\n');
    var waUrl = 'https://wa.me/' + WHATSAPP + '?text=' + encodeURIComponent(msg);
    var finish = function(ok){ track('lead_enviado', { fluxo: S.flow }); showDone(ok, waUrl); };
    fetch(ENDPOINT, { method:'POST', mode:'no-cors', headers:{ 'Content-Type':'text/plain;charset=utf-8' }, body: JSON.stringify(payload) })
      .then(function(){ finish(true); }).catch(function(){ finish(false); });
  }

  function showDone(ok, waUrl){
    var A = S.A[S.flow];
    var keys = S.flow === 'imp' ? ['produto','quantidade','fornecedor','experiencia','valor','canal'] : ['visitou','objetivo','segmento','idioma','quando'];
    var rows = keys.filter(function(k){ return A[k] && A[k].length; }).map(function(k){ return '<div class="row"><span>' + LABELS[k] + '</span><span>' + esc(Array.isArray(A[k]) ? A[k].join(', ') : A[k]) + '</span></div>'; }).join('');
    if (S.flow === 'imp' && S.fotos.length) rows += '<div class="row"><span>Fotos</span><span>' + S.fotos.length + ' enviada(s)</span></div>';
    var steps = S.flow === 'imp'
      ? ['A equipe analisa NCM, impostos, anuências e frete do seu produto.', 'Você recebe a estimativa de custo no WhatsApp.', 'Se fizer sentido, a Atto monta o orçamento completo da operação.']
      : ['A equipe avalia seu objetivo e o segmento.', 'Você recebe as próximas datas e um roteiro sugerido.', 'Combinamos os detalhes da viagem pelo WhatsApp.'];
    var first = esc((A.nome || '').trim().split(' ')[0]);
    $('doneUI').innerHTML = '<div class="done"><div class="ok"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></div>' +
      '<h3>' + (ok ? 'Recebemos sua simulação' : 'Quase lá') + (first ? ', ' + first : '') + '.</h3>' +
      '<p>' + (ok ? 'A equipe da Atto já foi avisada e responde no seu WhatsApp. Se quiser adiantar a conversa, toque no botão abaixo.' : 'Não conseguimos registrar agora. Toque no botão abaixo para enviar suas respostas direto no WhatsApp da Atto.') + '</p>' +
      '<div class="done-grid"><div class="box"><p class="lbl" style="margin-bottom:12px">Suas respostas</p>' + rows + '</div><div class="box"><p class="lbl" style="margin-bottom:12px">O que acontece agora</p>' +
      steps.map(function(t, i){ return '<div class="ns"><i>' + (i+1) + '</i><span>' + t + '</span></div>'; }).join('') + '</div></div>' +
      '<a class="wa-btn" href="' + waUrl + '" target="_blank" rel="noopener">' + (ok ? 'Falar agora no WhatsApp' : 'Enviar no WhatsApp') + '</a>' +
      '<p style="margin:22px auto 0"><button type="button" class="back" id="again">Fazer outra simulação</button></p></div>';
    $('flowUI').hidden = true; $('doneUI').hidden = false;
    $('again').addEventListener('click', function(){ S.A[S.flow] = {}; S.fotos = []; S.i = 0; S.started = false; $('next').disabled = false; $('doneUI').hidden = true; $('flowUI').hidden = false; render(); });
    document.querySelector('.card').scrollIntoView({ behavior:'smooth', block:'start' });
  }

  render();
})();
</script>
</body>
</html>
