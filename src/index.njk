<style>
:root{--bg:#070F1A;--card:rgba(12,24,40,.78);--alv:#F5F2DF;--muted:rgba(245,242,223,.62);--line:rgba(245,242,223,.14);--fa:#F84D14;--hz:#2084F6}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--alv);font-family:"Futura PT",Jost,system-ui,sans-serif;font-weight:300;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button,input{font-family:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 28px}
.lbl{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--fa);font-weight:400}
@keyframes up{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:none}}
@keyframes kb{from{transform:scale(1.05)}to{transform:scale(1.18) translateX(-3%)}}
@keyframes tick{to{transform:translateX(-50%)}}
@keyframes in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}
.u1{animation:up 1.1s cubic-bezier(.2,.7,.2,1) both}.u2{animation:up 1.1s .15s cubic-bezier(.2,.7,.2,1) both}.u3{animation:up 1.1s .3s cubic-bezier(.2,.7,.2,1) both}

/* HERO */
.hero{position:relative;min-height:88vh;display:flex;flex-direction:column;overflow:hidden}
.hero-media{position:absolute;inset:0}
.hero-media img,.hero-media video{width:100%;height:100%;object-fit:cover;filter:saturate(.6) brightness(.8);animation:kb 22s ease-in-out infinite alternate}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,15,26,.75),rgba(7,15,26,.2) 40%,var(--bg))}
nav{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:26px 0}
nav img{height:30px;width:auto}
.pill{font-size:12px;letter-spacing:.18em;text-transform:uppercase;border:1px solid rgba(245,242,223,.28);border-radius:999px;padding:11px 18px;transition:.2s}
.pill:hover{border-color:var(--fa);color:var(--fa)}
.hero-c{position:relative;z-index:2;margin-top:auto;padding-bottom:72px}
.hero h1{font-size:clamp(46px,7.4vw,108px);font-weight:200;letter-spacing:-.03em;line-height:.96;margin:20px 0 26px;max-width:960px}
.hero h1 b{font-weight:500}
.hero p{font-size:clamp(17px,1.6vw,20px);line-height:1.6;color:var(--muted);max-width:560px}
.cta{display:inline-flex;align-items:center;gap:12px;margin-top:34px;background:var(--alv);color:var(--bg);border-radius:999px;padding:17px 30px;font-size:16px;font-weight:500;transition:transform .2s}
.cta:hover{transform:translateY(-2px)}
.ticker{border-top:1px solid rgba(245,242,223,.1);border-bottom:1px solid rgba(245,242,223,.1);overflow:hidden;padding:20px 0}
.ticker div{display:flex;gap:56px;width:max-content;white-space:nowrap;font-size:20px;color:rgba(245,242,223,.5);animation:tick 40s linear infinite}
.ticker i{font-style:normal;color:var(--fa)}

/* SIMULADOR */
.sim{padding:110px 0 80px;background:radial-gradient(900px 500px at 85% 0%,rgba(32,132,246,.16),transparent 60%)}
.sim-head{text-align:center;max-width:760px;margin:0 auto 44px}
.sim-head h2{font-size:clamp(34px,4.6vw,60px);font-weight:200;letter-spacing:-.02em;line-height:1.05;margin-top:16px}
.sim-head h2 b{font-weight:500}
.card{max-width:960px;margin:0 auto;border:1px solid var(--line);border-radius:28px;background:var(--card);backdrop-filter:blur(20px);padding:40px}
.tabs{display:flex;justify-content:center;margin-bottom:34px}
.tabs div{display:flex;border:1px solid var(--line);border-radius:999px;padding:5px}
.tabs button{border:0;border-radius:999px;padding:12px 22px;font-size:15px;background:transparent;color:rgba(245,242,223,.7);cursor:pointer;transition:.2s}
.tabs button[aria-selected=true]{background:var(--alv);color:var(--bg);font-weight:500}
.meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;font-size:13px;color:rgba(245,242,223,.5)}
.bars{display:flex;gap:6px;margin-bottom:38px}
.bars i{flex:1;height:3px;border-radius:3px;background:rgba(245,242,223,.12);transition:background .3s}
.bars i.on{background:var(--fa)}
.step{animation:in .45s cubic-bezier(.2,.7,.2,1) both}
.step h3{font-size:clamp(26px,3.2vw,38px);font-weight:300;letter-spacing:-.015em;line-height:1.15;margin-bottom:10px}
.step .sub{font-size:17px;line-height:1.55;color:var(--muted);margin-bottom:30px}
.f label,.q{display:block;font-size:14px;color:rgba(245,242,223,.72);margin-bottom:9px;font-weight:400}
.f input{width:100%;background:rgba(7,15,26,.6);border:1px solid rgba(245,242,223,.18);border-radius:14px;color:var(--alv);font-size:17px;padding:16px 18px;transition:border-color .2s}
.f input:focus{outline:none;border-color:var(--fa)}
.f input::placeholder{color:rgba(245,242,223,.32)}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{border:1px solid rgba(245,242,223,.16);background:transparent;color:rgba(245,242,223,.82);border-radius:999px;padding:10px 17px;font-size:15px;cursor:pointer;transition:.2s}
.chip:hover{border-color:rgba(245,242,223,.4)}
.chip.sel{border-color:var(--fa);background:rgba(248,77,20,.12);color:var(--alv)}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
.opt{text-align:left;border:1px solid var(--line);background:rgba(245,242,223,.02);border-radius:18px;padding:21px 22px;color:var(--alv);cursor:pointer;display:flex;justify-content:space-between;gap:14px;transition:.2s}
.opt:hover{border-color:rgba(245,242,223,.38)}
.opt b{display:block;font-size:19px;font-weight:400;margin-bottom:5px}
.opt span{display:block;font-size:15px;line-height:1.5;color:rgba(245,242,223,.55)}
.opt em{flex:none;width:24px;height:24px;border-radius:50%;border:1px solid rgba(245,242,223,.28);display:grid;place-items:center}
.opt.sel{border-color:var(--fa);background:rgba(248,77,20,.08)}
.opt.sel b{font-weight:500}
.opt.sel em{background:var(--fa);border-color:var(--fa)}
.opt.sel em::after{content:"";width:9px;height:5px;border:2px solid #fff;border-top:0;border-right:0;transform:rotate(-45deg) translate(1px,-1px)}
.multi{font-size:14px;color:var(--fa);margin:-16px 0 16px}
.photos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px}
@media(max-width:620px){.meta .lbl{font-size:10px;letter-spacing:.18em}#stepLabel{white-space:nowrap}.photos{grid-template-columns:repeat(2,1fr)}.card{padding:24px 18px}.tabs button{padding:11px 14px;font-size:14px}}
.ph{position:relative;aspect-ratio:1;border-radius:16px;border:1px dashed rgba(245,242,223,.24);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:rgba(245,242,223,.6);font-size:14px;cursor:pointer;overflow:hidden;background:transparent;transition:.2s}
.ph:hover{border-color:rgba(245,242,223,.5)}
.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ph .x{position:absolute;top:8px;right:8px;width:28px;height:28px;border-radius:50%;background:rgba(7,15,26,.75);color:#fff;border:0;cursor:pointer;font-size:14px}
.note{margin-top:20px;padding:17px 20px;border-radius:16px;border:1px solid rgba(32,132,246,.35);background:rgba(32,132,246,.08);font-size:15px;line-height:1.55}
.lgpd{margin-top:18px;font-size:13px;color:rgba(245,242,223,.48)}
.err{margin-top:18px;color:#ff8a5c;font-size:15px;font-weight:400}
.nav2{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:38px;padding-top:26px;border-top:1px solid rgba(245,242,223,.1)}
.back{border:1px solid rgba(245,242,223,.2);background:transparent;color:var(--alv);border-radius:999px;padding:14px 22px;font-size:15px;cursor:pointer}
.next{border:0;background:var(--fa);color:#fff;border-radius:999px;padding:16px 28px;font-size:16px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:10px;transition:filter .2s}
.next:hover{filter:brightness(1.08)}
.next[disabled]{opacity:.7;cursor:wait}
.spin{width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}
.done{text-align:center;animation:in .5s both}
.done .ok{width:72px;height:72px;border-radius:50%;background:var(--fa);margin:0 auto 22px;display:grid;place-items:center}
.done h3{font-size:clamp(30px,3.6vw,42px);font-weight:300;margin-bottom:12px}
.done p{max-width:560px;margin:0 auto 30px;font-size:17px;line-height:1.6;color:var(--muted)}
.done-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;text-align:left;margin-bottom:28px}
.box{border:1px solid rgba(245,242,223,.12);border-radius:18px;padding:22px}
.row{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-bottom:1px solid rgba(245,242,223,.08);font-size:15px}
.row span:first-child{color:rgba(245,242,223,.55)}
.row span:last-child{text-align:right}
.ns{display:flex;gap:14px;padding:9px 0;font-size:16px;line-height:1.5}
.ns i{flex:none;width:28px;height:28px;border-radius:50%;border:1px solid rgba(245,242,223,.3);display:grid;place-items:center;font-style:normal;font-size:13px}
.wa-btn{display:inline-flex;align-items:center;gap:10px;background:#25D366;color:#05301a;border-radius:999px;padding:16px 28px;font-weight:500;font-size:16px}
.trust{display:flex;justify-content:center;gap:40px;flex-wrap:wrap;margin-top:34px;font-size:14px;color:rgba(245,242,223,.55)}

/* COMO FUNCIONA */
.how{padding:110px 0}
.how-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap;margin-bottom:50px}
.how h2{font-size:clamp(38px,5vw,70px);font-weight:200;letter-spacing:-.02em;line-height:1}
.how h2 b{font-weight:500}
.how-head p{max-width:400px;font-size:18px;line-height:1.6;color:var(--muted)}
.line{width:80px;height:1px;background:var(--fa);margin-bottom:28px}
.r{display:grid;grid-template-columns:90px minmax(0,1fr) minmax(0,1.3fr);gap:28px;padding:34px 0;border-top:1px solid rgba(245,242,223,.12);align-items:baseline;transition:background .3s}
.r:last-child{border-bottom:1px solid rgba(245,242,223,.12)}
.r:hover{background:rgba(245,242,223,.025)}
.r span{font-size:14px;letter-spacing:.2em;color:var(--fa)}
.r h4{font-size:clamp(24px,2.6vw,34px);font-weight:300}
.r p{font-size:17px;line-height:1.6;color:var(--muted)}
@media(max-width:760px){.r{grid-template-columns:1fr;gap:8px}}

/* FAQ */
.faq{padding:0 0 110px}
.faq h2{font-size:clamp(34px,4vw,52px);font-weight:200;margin-bottom:30px}
details{border-bottom:1px solid rgba(245,242,223,.12)}
summary{list-style:none;cursor:pointer;padding:24px 44px 24px 0;font-size:21px;font-weight:300;position:relative}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";position:absolute;right:4px;top:18px;font-size:30px;color:var(--fa);transition:transform .25s}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 0 24px;max-width:760px;font-size:17px;line-height:1.65;color:var(--muted)}

.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px}
.pc{display:block;transition:transform .4s cubic-bezier(.2,.7,.2,1)}.pc:hover{transform:translateY(-6px)}
.pc-img{position:relative;aspect-ratio:16/10;border-radius:16px;background:#12233A center/cover;margin-bottom:18px}
.pc-img{overflow:hidden}.pc-img img{width:100%;height:100%;object-fit:cover;display:block}
.pc-img span{position:absolute;left:14px;bottom:14px;font-size:12px;letter-spacing:.12em;background:rgba(7,15,26,.65);padding:6px 10px;border-radius:999px}
.pc h3{font-size:23px;font-weight:300;line-height:1.3;margin-top:8px}
footer{border-top:1px solid rgba(245,242,223,.1);padding:40px 0 110px;font-size:14px;color:rgba(245,242,223,.5)}
footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.wa{position:fixed;right:20px;bottom:20px;z-index:50;width:58px;height:58px;border-radius:50%;background:#25D366;display:grid;place-items:center;box-shadow:0 10px 30px rgba(0,0,0,.4);transition:transform .2s}
.wa:hover{transform:scale(1.06)}
[hidden]{display:none!important}
@media (prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto}}
</style>
</head>
